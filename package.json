{
  "name": "smart-tourist",
  "version": "1.0.0",
  "description": "Система для пошуку та бронювання подорожей по Україні.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node --check index.js && node --check database/index.js",
    "build": "echo 'Build successful' && exit 0",
    "prepare": "husky",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"services/**\" --test-coverage-include=\"middleware/**\" --test-coverage-include=\"lib/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"tests/**/*.test.js\"",
    "test:coverage:all": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-exclude=\"eslint.config.mjs\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=85 \"tests/**/*.test.js\"",
    "check:http": "node scripts/check-http.js"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "node ./node_modules/eslint/bin/eslint.js --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anna-1804/Smart-tourist.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Anna-1804/Smart-tourist/issues"
  },
  "homepage": "https://github.com/Anna-1804/Smart-tourist#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8"
  },
  "dependencies": {
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "sqlite3": "^6.0.1"
  }
}
