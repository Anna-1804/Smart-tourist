<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Адмін-панель - Smart Tourist</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>⚙️ Панель Управління Адміністратора</h2>
      <a href="/" class="btn btn-outline-primary btn-sm">На головну</a>
    </div>

    <% if (message) { %>
      <div class="alert <%= isError ? 'alert-danger' : 'alert-success' %>"><%= message %></div>
    <% } %>

    <div class="row">
      <!-- Створення туру (Сценарій 2.1) -->
      <div class="col-md-5 mb-4">
        <div class="card p-3 shadow-sm">
          <h4>Додати новий тур</h4>
          <form action="/admin/tours?role=admin" method="POST">
            <div class="mb-2">
              <label class="form-label small">Місто</label>
              <select name="city_id" class="form-select form-select-sm" required>
                <% cities.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small">Назва туру</label>
              <input type="text" name="title" class="form-control form-control-sm" required>
            </div>
            <div class="mb-2">
              <label class="form-label small">Ціна (грн)</label>
              <input type="number" name="price" class="form-control form-control-sm" required min="0">
            </div>
            <div class="mb-2">
              <label class="form-label small">Кількість місць</label>
              <input type="number" name="available_slots" class="form-control form-control-sm" required min="0">
            </div>
            <div class="mb-2">
              <label class="form-label small">URL фотографії</label>
              <input type="url" name="image_url" placeholder="https://example.com/image.jpg" class="form-control form-control-sm">
            </div>
            <div class="mb-2">
              <label class="form-label small">Опис</label>
              <textarea name="description" class="form-control form-control-sm" rows="2"></textarea>
            </div>
            <div class="mb-2">
              <label class="form-label small">Програма</label>
              <textarea name="program" class="form-control form-control-sm" rows="2"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-sm w-100 mt-2">Створити тур</button>
          </form>
        </div>
      </div>

      <div class="col-md-7">
        <!-- Керування розкладом та параметрами турів (Сценарій 2.2) -->
        <div class="card p-3 shadow-sm mb-4">
          <h4>Керування наявними турами</h4>
          <% tours.forEach(t => { %>
            <div class="border rounded p-3 mb-3 bg-white">
              <form action="/admin/tours/<%= t.id %>/update?role=admin" method="POST">
                <div class="row g-2 align-items-center mb-2">
                  <div class="col-md-5">
                    <label class="form-label small mb-0 text-muted">Назва</label>
                    <input type="text" name="title" value="<%= t.title %>" class="form-control form-control-sm" required>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small mb-0 text-muted">Ціна (грн)</label>
                    <input type="number" name="price" value="<%= t.price %>" class="form-control form-control-sm" required min="0">
                  </div>
                  <div class="col-md-2">
                    <label class="form-label small mb-0 text-muted">Місць</label>
                    <input type="number" name="available_slots" value="<%= t.available_slots %>" class="form-control form-control-sm" required min="0">
                  </div>
                  <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-sm btn-success w-100 mt-3">Зберегти</button>
                  </div>
                </div>

                <div class="mb-2">
                  <label class="form-label small mb-0 text-muted">URL фотографії</label>
                  <input type="url" name="image_url" value="<%= t.image_url %>" class="form-control form-control-sm">
                </div>

                <div class="mb-2">
                  <label class="form-label small mb-0 text-muted">Опис</label>
                  <textarea name="description" class="form-control form-control-sm" rows="2"><%= t.description %></textarea>
                </div>

                <div class="mb-2">
                  <label class="form-label small mb-0 text-muted">Програма</label>
                  <textarea name="program" class="form-control form-control-sm" rows="2"><%= t.program %></textarea>
                </div>
              </form>
            </div>
          <% }) %>
        </div>

        <!-- Перевірка бронювань (Сценарій 2.4) -->
        <div class="card p-3 shadow-sm mb-4">
          <h4>Останні бронювання</h4>
          <table class="table table-sm">
            <thead>
              <tr><th>Тур</th><th>Турист</th><th>Email</th><th>Місць</th></tr>
            </thead>
            <tbody>
              <% if (bookings.length === 0) { %><tr><td colspan="4" class="text-muted">Бронювань поки немає</td></tr><% } %>
              <% bookings.forEach(b => { %>
                <tr>
                  <td><%= b.tour_title %></td>
                  <td><%= b.user_name %></td>
                  <td><%= b.user_email %></td>
                  <td><span class="badge bg-secondary"><%= b.slots_booked %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Аналіз відгуків (Сценарій 2.3) -->
        <div class="card p-3 shadow-sm">
          <h4>Усі відгуки</h4>
          <% if (reviews.length === 0) { %><p class="text-muted small">Відгуки відсутні</p><% } %>
          <% reviews.forEach(r => { %>
            <div class="border-bottom py-1">
              <strong><%= r.user_name %></strong> (★ <%= r.rating %>/5): 
              <span class="text-muted"><%= r.comment %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>